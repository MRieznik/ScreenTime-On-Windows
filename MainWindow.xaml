<Window x:Class="ScreenTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:ScreenTimeTracker.ViewModels"
        mc:Ignorable="d"
        Title="Screen Time Tracker"
        Icon="Assets/app_icon.ico"
        Height="800" Width="1160"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Inter, -apple-system, Sans-Serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="StatisticButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BrushCardBg}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}"/>
    </Window.InputBindings>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" Content="Configuración"
                    Command="{Binding ToggleSettingsCommand}" IsEnabled="{Binding IsInitialized}"/>
            <TextBlock Text="Screen Time Tracker" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="1" Padding="14,8" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" Content="{Binding PauseButtonText}"
                        Command="{Binding TogglePauseCommand}" IsEnabled="{Binding IsInitialized}" Margin="14,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding TrackingStatusColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TrackingStatusText}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveAppText, StringFormat='En primer plano: {0}'}"
                               Visibility="{Binding HasActiveApp, Converter={StaticResource BoolToVisConverter}}"
                               Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="16,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <Border Background="{StaticResource BrushAccentBg}" BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Ver resumen semanal"
                            Command="{Binding OpenCurrentWeekCommand}" IsEnabled="{Binding IsInitialized}"
                            VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="Promedio general de esta semana" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding WeeklyOverviewAverage}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="Desde el lunes hasta hoy" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Style="{StaticResource ModernButtonStyle}" Content="‹  Día anterior"
                            Command="{Binding PreviousDayCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Content="Hoy"
                            Command="{Binding GoToTodayCommand}" IsEnabled="{Binding CanGoToNextDay}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource ModernButtonStyle}" Content="Día siguiente  ›"
                            Command="{Binding NextDayCommand}" IsEnabled="{Binding CanGoToNextDay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Actividad diaria" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentDateFormatted}" Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- 3. SUMMARY CARDS (Flat 1px Borders, Spacious, Single Turquoise Accent) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 0: Total General -->
                <Button Grid.Column="0" Style="{StaticResource StatisticButtonStyle}"
                        Command="{Binding OpenChartCommand}" CommandParameter="Total"
                        AutomationProperties.Name="Ver semana: tiempo total" ToolTip="Ver semana: tiempo total">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⏱" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DateNavigationLabel, StringFormat='{}TIEMPO TOTAL {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalScreenTime}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="Ver semana →" FontSize="11" Foreground="{StaticResource BrushAccent}"/>
                    </StackPanel>
                </Button>

                <!-- Card 1: Juegos -->
                <Button Grid.Column="2" Style="{StaticResource StatisticButtonStyle}"
                        Command="{Binding OpenChartCommand}" CommandParameter="Juegos"
                        AutomationProperties.Name="Ver semana: juegos" ToolTip="Ver semana: juegos">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="JUEGOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding GamingPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                        </Grid>
                        <TextBlock Text="{Binding GamingTime}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding GamingPercent}" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TopGame}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ver semana →" FontSize="11" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Card 2: Apps de Escritorio -->
                <Button Grid.Column="4" Style="{StaticResource StatisticButtonStyle}"
                        Command="{Binding OpenChartCommand}" CommandParameter="Aplicaciones de Escritorio"
                        AutomationProperties.Name="Ver semana: escritorio" ToolTip="Ver semana: escritorio">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ESCRITORIO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding DesktopPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                        </Grid>
                        <TextBlock Text="{Binding DesktopTime}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding DesktopPercent}" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TopDesktopApp}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ver semana →" FontSize="11" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Card 3: Navegación Web -->
                <Button Grid.Column="6" Style="{StaticResource StatisticButtonStyle}"
                        Command="{Binding OpenChartCommand}" CommandParameter="Navegación Web"
                        AutomationProperties.Name="Ver semana: navegación web" ToolTip="Ver semana: navegación web">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☁" FontSize="14" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="NAVEGACIÓN WEB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding WebPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}"/>
                        </Grid>
                        <TextBlock Text="{Binding WebTime}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding WebPercent}" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TopWebDomain}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Ver semana →" FontSize="11" Foreground="{StaticResource BrushAccent}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 4. TABLE FILTERS & CONTROLS -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Buttons (Geometric Segments, CornerRadius=0) -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DateNavigationLabel, StringFormat='{}Detalle · {0}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,18,0"/>

                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Todas" Command="{Binding SetFilterCommand}" CommandParameter="Todas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="Todas">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Content="🎮  Juegos" Command="{Binding SetFilterCommand}" CommandParameter="Juegos">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="Juegos">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Content="📁  Apps" Command="{Binding SetFilterCommand}" CommandParameter="Aplicaciones de Escritorio">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="Aplicaciones de Escritorio">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Width="1" Background="{StaticResource BrushCardBorder}"/>
                        <Button Content="☁  Web" Command="{Binding SetFilterCommand}" CommandParameter="Navegación Web">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="Navegación Web">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter Property="Background" Value="{StaticResource BrushAccentBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Filtrar por categoría" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 5. ACTIVITIES LIST / TABLE (Catalog Grid Style, CornerRadius=0) -->
        <Border Grid.Row="4" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0">
            <Grid>
                <!-- Empty State Message -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoActivities, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,50,0,50">
                    <TextBlock Text="◷" FontSize="36" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Aún no hay actividades registradas en esta fecha" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Las aplicaciones que uses aparecerán aquí automáticamente cada 5 segundos." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- List of Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:ActivityDisplayItem}">
                                <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="18,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Monochrome Outline Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding CategoryIcon}" FontSize="14" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Name & Window Title -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Detail}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WindowTitle}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Category Badge (Flat, Minimal) -->
                                        <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,3">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3" Text="{Binding FormattedDuration}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                                        <!-- Proportion / Share Bar (Turquoise Accent) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}% del total'}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding PercentageOfTotal}" Maximum="100"/>
                                        </StackPanel>

                                        <!-- Last Active -->
                                        <TextBlock Grid.Column="5" Text="{Binding LastActiveText}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 6. SETTINGS OVERLAY FOR GENERAL & GAME DIRECTORIES (Flat, CornerRadius=0) -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#D90C0C0E" KeyboardNavigation.TabNavigation="Cycle"
              IsVisibleChanged="OverlayVisibilityChanged">
            <Border Width="680" MaxHeight="680"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Title & Close -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Tabs -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Tab Content -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="18" Margin="0,0,10,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="Configuración" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Preferencias del sistema y bibliotecas de detección" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="28,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Content="Cerrar" Command="{Binding ToggleSettingsCommand}" Padding="10,6" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Tab Switcher (Flat Segments, CornerRadius=0) -->
                    <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Margin="0,0,0,22">
                        <UniformGrid Rows="1" Columns="2">
                            <!-- Tab General -->
                            <Button Content="General" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="General">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeneralTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab Juegos -->
                            <Button Content="Bibliotecas de Juegos" Command="{Binding SwitchSettingsTabCommand}" CommandParameter="Juegos">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGamesTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#18181B"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- TAB CONTENT AREA -->
                    <!-- 1. GENERAL TAB -->
                    <ScrollViewer Grid.Row="2" Visibility="{Binding IsGeneralTabSelected, Converter={StaticResource BoolToVisConverter}}"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Auto-start Windows Toggle Card (Flat) -->
                            <Border Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Iniciar con Windows" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Ejecuta Screen Time Tracker en segundo plano automáticamente al iniciar sesión en tu PC."
                                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitchStyle}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}"
                                    BorderThickness="1" Padding="20,16">
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding InactivityOptions}"
                                              SelectedValue="{Binding InactivityTimeoutMinutes}" SelectedValuePath="Minutes"
                                              DisplayMemberPath="Label" AutomationProperties.Name="Pausar por inactividad"
                                              MinWidth="130" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Pausar por inactividad" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="Sin teclado ni ratón durante el tiempo elegido. Podés desactivarla para videos o juegos con mando."
                                                   Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. GAME DIRECTORIES TAB (Flat) -->
                    <Grid Grid.Row="2" Visibility="{Binding IsGamesTabSelected, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Description & Input -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Los procesos activos que se ejecuten dentro de estas carpetas se detectarán automáticamente como 'Juegos' (Steam, Epic, Battle.net, etc.). No requieres registrar ejecutables individualmente."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                            <!-- Add Directory Input -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewDirectoryInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ejemplo: D:\Juegos\SteamLibrary\steamapps\common"/>
                                <Button Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Content="Examinar..." Command="{Binding BrowseDirectoryCommand}"/>
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" Content="Agregar Carpeta" Command="{Binding AddDirectoryCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Directories List (Flat) -->
                        <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8" MaxHeight="270">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GameDirectories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="12,8" Margin="0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🎮" Foreground="{StaticResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Content="Eliminar"
                                                            FontSize="11"
                                                            Padding="8,3"
                                                            Command="{Binding DataContext.RemoveDirectoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desarrollado por Marcos Rieznik" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="Licencia GNU General Public License v3.0 (GPLv3)" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. WEEKLY BAR CHART MODAL OVERLAY (Flat, Geometric, CornerRadius=0) -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsChartOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#D90C0C0E" KeyboardNavigation.TabNavigation="Cycle"
              IsVisibleChanged="OverlayVisibilityChanged">
            <Border MaxWidth="880"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="18,16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Title & Close -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Week Navigation Strip -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Category Filter Segmented Pills -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 3: KPI Strip -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 4: Bar Chart Area -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title & Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title + Icon -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ChartIcon}" FontSize="20" Margin="0,0,10,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChartTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Elegí un día del gráfico para ver su actividad" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="30,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Content="Cerrar" Command="{Binding CloseChartCommand}" Padding="10,6" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 1: Week Navigation Strip (Flat Scandinavian, CornerRadius=0) -->
                        <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Previous Week Button -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Command="{Binding PreviousWeekCommand}"
                                        Padding="12,6"
                                        ToolTip="Ver la semana anterior">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◀" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Semana anterior" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Center Date Display + Context Badge -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="{Binding ChartSubtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,3" Margin="0,3,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ChartWeekRelativeLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Next Week and 'Esta Semana' Jump Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ModernButtonStyle}"
                                            Command="{Binding CurrentWeekCommand}"
                                            Visibility="{Binding CanGoToCurrentWeek, Converter={StaticResource BoolToVisConverter}}"
                                            Padding="10,6"
                                            Margin="0,0,8,0"
                                            ToolTip="Volver a la semana en curso">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◷" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Esta Semana" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource ModernButtonStyle}"
                                            Command="{Binding NextWeekCommand}"
                                            IsEnabled="{Binding CanGoToNextWeek}"
                                            Padding="12,6"
                                            ToolTip="Avanzar a la siguiente semana">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Semana siguiente" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="▶" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Category Filter Segmented Strip (CornerRadius=0) -->
                        <Border Grid.Row="2" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Margin="0,0,0,10">
                            <UniformGrid Rows="1" Columns="4">
                                <!-- 1. VOLVER A TODO -->
                                <Button Content="⏱  Todo" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Total">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChartTotalSelected}" Value="True">
                                                    <Setter Property="Background" Value="#18181B"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 2. JUEGOS -->
                                <Button Content="🎮  Juegos" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Juegos">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChartGamingSelected}" Value="True">
                                                    <Setter Property="Background" Value="#18181B"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 3. ESCRITORIO -->
                                <Button Content="📁  Escritorio" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Aplicaciones de Escritorio">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChartDesktopSelected}" Value="True">
                                                    <Setter Property="Background" Value="#18181B"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 4. WEB -->
                                <Button Content="☁  Web" Command="{Binding SwitchChartCategoryCommand}" CommandParameter="Navegación Web">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChartWebSelected}" Value="True">
                                                    <Setter Property="Background" Value="#18181B"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- KPI Summary Strip (Flat, CornerRadius=0) -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="TOTAL DE LA SEMANA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding WeekTotalFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="PROMEDIO DIARIO" ToolTip="Total dividido por los días transcurridos de la semana" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding WeekAverageFormatted}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="DÍA CON MÁS ACTIVIDAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding WeekPeakDay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bar Chart & Highlights Area -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bar Chart Area (Flat Pillars, CornerRadius=0) -->
                            <Border Grid.Column="0" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="8,12,8,10">
                                <ItemsControl ItemsSource="{Binding WeekBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource StatisticButtonStyle}" Padding="0,5"
                                                    Margin="2,0" VerticalAlignment="Bottom"
                                                    Command="{Binding DataContext.SelectDayFromChartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}"
                                                    AutomationProperties.Name="{Binding DayName}" AutomationProperties.HelpText="{Binding FormattedTime}"
                                                    ToolTip="{Binding FormattedTime}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="130"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Value on top of bar -->
                                                    <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8"
                                                            Background="#18181B" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="3,3">
                                                        <TextBlock Text="{Binding HoursLabel}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center"
                                                                   ToolTip="{Binding FormattedTime}"/>
                                                    </Border>

                                                    <!-- The Vertical Bar Container (Flat, CornerRadius=0) -->
                                                    <Grid Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <!-- Baseline empty background pillar -->
                                                        <Border Width="34" Height="130" Background="#1E1E24" CornerRadius="0"/>

                                                        <!-- Filled Bar (Turquoise Accent) -->
                                                        <Border Width="34"
                                                                Height="{Binding BarHeight}"
                                                                Background="{StaticResource BrushAccent}"
                                                                CornerRadius="0"
                                                                VerticalAlignment="Bottom"
                                                                ToolTip="{Binding FormattedTime}"/>
                                                    </Grid>

                                                    <!-- Day Labels on Bottom -->
                                                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding DayShort}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DateString}" FontSize="10"
                                                                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                                        <!-- TODAY Badge (Flat) -->
                                                        <Border Background="{StaticResource BrushAccent}" CornerRadius="0" Padding="6,2" Margin="0,4,0,0"
                                                                HorizontalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="HOY" FontSize="9" FontWeight="Bold" Foreground="#121214"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Highlights Area -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Trend -->
                                <Border Grid.Row="0" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="TENDENCIA SEMANAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Text="{Binding WeekTrendFormatted}" FontSize="15" FontWeight="Bold" Foreground="{Binding WeekTrendColor}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Top Apps -->
                                <Border Grid.Row="2" Background="#121214" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="TOP 3 APLICACIONES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Text="{Binding WeekTopAppsFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" LineHeight="20" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
